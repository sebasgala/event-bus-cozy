# Configuración de entorno para event-bus (fase 9.3).
# Copia este archivo a .env fuera del repositorio y completa los valores reales.

PORT=3005
PORT_EVENT_BUS=3005

# Publicador del feed (fase 9.4): exactamente uno de los dos publica. Obligatorio; cualquier otro valor impide arrancar.
# event-bus = este proceso publica; monolito = publica el backend.
PUBLICADOR_ACTIVO=

# Conexión a PostgreSQL (base cozy_v2) y clave del rol comun
DATABASE_URL=
DATABASE_SSL=false
DB_CLAVE_COMUN=

# URL de conexión AMQP a RabbitMQ (definida en .env fuera del repo)
RABBITMQ_URL=

# URL interna del servicio de catálogo (para filtrar eventos por propietario cuando consulta un ADMIN no superadmin)
CATALOGO_URL=http://localhost:3002

# Verificación de tokens en GET /api/v2/alojamientos/eventos
JWT_SECRET=
OAUTH_SHARED_SECRET=
COZY_SERVICE_KEYS=

